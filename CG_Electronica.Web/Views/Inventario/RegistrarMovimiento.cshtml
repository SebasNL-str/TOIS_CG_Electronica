@{
    ViewData["Title"] = "Registrar Movimiento de Inventario";
    var tieneErrorObs = ViewData.ModelState["observacion"]?.Errors.Count > 0;
}

<div class="container-fluid px-4">
    <!-- Encabezado y Breadcrumbs -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
        <div>
            <h1 class="mb-0 text-white">Registrar Movimiento</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-primary text-decoration-none">Inicio</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-primary text-decoration-none">Inventario</a></li>
                <li class="breadcrumb-item active text-white-50">Registrar</li>
            </ol>
        </div>
    </div>

    <!-- Tarjeta del Formulario en Modo Oscuro -->
    <div class="card shadow-lg border border-secondary border-opacity-25 rounded-4 overflow-hidden mb-4" style="background-color: #111c30;">

        <!-- Franja superior azul de acento -->
        <div class="bg-primary" style="height: 5px;"></div>

        <!-- Encabezado de la Tarjeta -->
        <div class="card-header border-bottom border-secondary border-opacity-25 py-3" style="background-color: rgba(0, 0, 0, 0.2);">
            <span class="fw-bold text-white fs-5">
                <i class="bi bi-arrow-left-right text-primary me-2"></i>Formulario de Movimiento de Stock
            </span>
        </div>

        <div class="card-body p-4 text-start">
            <form asp-action="RegistrarMovimiento" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <!-- Fila 1: Producto, Tipo y Motivo -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-white fw-semibold small">Producto a Afectar</label>
                        <select name="idProducto" class="form-select text-white border-secondary border-opacity-50"
                                style="background-color: #0d1527;" asp-items="ViewBag.Productos" required>
                            <option value="" class="text-muted">-- Seleccione un Producto --</option>
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label text-white fw-semibold small">Tipo de Movimiento</label>
                        <select name="tipoMovimiento" class="form-select text-white border-secondary border-opacity-50"
                                id="tipoMovimiento" style="background-color: #0d1527;" required>
                            <option value="Entrada">Entrada (+)</option>
                            <option value="Salida">Salida (-)</option>
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label text-white fw-semibold small">Motivo</label>
                        <select name="motivo" class="form-select text-white border-secondary border-opacity-50"
                                id="motivo" style="background-color: #0d1527;" required>
                            <option value="">-- Seleccione un Motivo --</option>
                            <option value="Entrada por compra" data-tipo="Entrada">Entrada por compra</option>
                            <option value="Entrada por devolución de cliente" data-tipo="Entrada">Entrada por devolución de cliente</option>
                            <option value="Salida por producto dañado" data-tipo="Salida">Salida por producto dañado</option>
                            <option value="Ajuste de inventario" data-tipo="Universal">Ajuste de inventario</option>
                        </select>
                    </div>
                </div>

                <!-- Fila 2: Cantidad y Costo Unitario en Córdobas (C$) -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-white fw-semibold small">Cantidad de Unidades</label>
                        <div class="input-group">
                            <span class="input-group-text border-secondary border-opacity-50 text-white-50"
                                  style="background-color: rgba(255, 255, 255, 0.08);">
                                <i class="bi bi-box-seam"></i>
                            </span>
                            <input name="cantidad" type="number" min="1" class="form-control text-white border-secondary border-opacity-50"
                                   style="background-color: #0d1527;" required value="1" />
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <!-- Moneda cambiada a Córdobas (C$) -->
                        <label class="form-label text-white fw-semibold small">Costo Unitario (C$)</label>
                        <div class="input-group">
                            <span class="input-group-text border-secondary border-opacity-50 text-white-50 fw-bold"
                                  style="background-color: rgba(255, 255, 255, 0.08);">
                                C$
                            </span>
                            <input name="precioCompraUnitario" type="number" step="0.01" min="0" class="form-control text-white border-secondary border-opacity-50"
                                   style="background-color: #0d1527;" value="0.00" required />
                        </div>
                        <small class="text-white-50">Costo de adquisición unitario en Córdobas.</small>
                    </div>
                </div>

                <!-- Fila 3: Observación / Justificación -->
                <div class="mb-4">
                    <label class="form-label text-white fw-semibold small">Observación / Justificación</label>
                    <textarea name="observacion" class="form-control text-white border-secondary border-opacity-50 @(tieneErrorObs ? "is-invalid" : "")"
                              rows="3" style="background-color: #0d1527;"
                              placeholder="Detalle el motivo del movimiento...">@ViewBag.Observacion</textarea>
                    @Html.ValidationMessage("observacion", new { @class = "text-danger small mt-1 d-block" })
                </div>

                <!-- Botones de Acción -->
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm fw-semibold">
                        <i class="bi bi-check-circle-fill me-1"></i> Guardar Movimiento
                    </button>
                    <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4">
                        <i class="bi bi-x-circle me-1"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tipoSelect = document.getElementById("tipoMovimiento");
            const motivoSelect = document.getElementById("motivo");

            if (!tipoSelect || !motivoSelect) return;

            const opcionesOriginales = Array.from(motivoSelect.options);

            function actualizarMotivos() {
                const tipoSeleccionado = tipoSelect.value;
                const motivoActual = motivoSelect.value;

                motivoSelect.innerHTML = "";

                const optionDefault = document.createElement("option");
                optionDefault.value = "";
                optionDefault.textContent = "-- Seleccione un Motivo --";
                motivoSelect.appendChild(optionDefault);

                let motivoAunValido = false;

                opcionesOriginales.forEach(opt => {
                    if (!opt.value) return;

                    const categoria = opt.getAttribute("data-tipo");

                    if (!categoria || categoria === "Universal" || categoria === tipoSeleccionado) {
                        motivoSelect.appendChild(opt);

                        if (opt.value === motivoActual) {
                            motivoAunValido = true;
                        }
                    }
                });

                if (!motivoAunValido) {
                    motivoSelect.value = "";
                }
            }

            tipoSelect.addEventListener("change", actualizarMotivos);
            actualizarMotivos();
        });
    </script>
}