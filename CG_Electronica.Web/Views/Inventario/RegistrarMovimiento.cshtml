@{
    ViewData["Title"] = "Registrar Movimiento de Inventario";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Registrar Movimiento Manual</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index">Inventario</a></li>
        <li class="breadcrumb-item active">Registrar</li>
    </ol>

    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="RegistrarMovimiento">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Producto</label>
                        <select name="idProducto" class="form-select" asp-items="ViewBag.Productos" required>
                            <option value="">-- Seleccione un Producto --</option>
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label fw-bold">Tipo de Movimiento</label>
                        <select name="tipoMovimiento" class="form-select" id="tipoMovimiento" required>
                            <option value="Entrada">Entrada</option>
                            <option value="Salida">Salida</option>
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label fw-bold">Motivo</label>
                        <select name="motivo" class="form-select" id="motivo" required>
                            <option value="Entrada por compra">Entrada por compra</option>
                            <option value="Entrada por devolución de cliente">Entrada por devolución de cliente</option>
                            <option value="Salida por producto dañado">Salida por producto dañado</option>
                            <option value="Ajuste de inventario">Ajuste de inventario</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Cantidad</label>
                        <input name="cantidad" type="number" min="1" class="form-control" required value="1" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Costo Unitario ($)</label>
                        <input name="precioCompraUnitario" type="number" step="0.01" class="form-control" value="0.00" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Observación / Justificación</label>
                    <textarea name="observacion" class="form-control" rows="3" placeholder="Detalle el motivo del movimiento..."></textarea>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success"><i class="fas fa-check"></i> Guardar Movimiento</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>