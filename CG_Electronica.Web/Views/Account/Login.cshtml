@model CG_Electronica.Web.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="col-md-6 col-lg-4">
        <!-- Tarjeta con fondo oscuro elegante, sombras y bordes suaves -->
        <div class="card shadow-lg border border-secondary border-opacity-25 rounded-4 overflow-hidden" style="background-color: #111c30;">

            <!-- Franja superior en azul primario -->
            <div class="bg-primary" style="height: 5px;"></div>

            <!-- Cabecera con branding C&G Electrónica -->
            <div class="card-header border-0 text-center py-4" style="background-color: rgba(0, 0, 0, 0.2);">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 shadow-sm"
                     style="width: 70px; height: 70px; background-color: rgba(13, 110, 253, 0.15); border: 1px solid rgba(13, 110, 253, 0.35);">
                    <i class="bi bi-phone-fill text-primary" style="font-size: 2.2rem;"></i>
                </div>
                <h3 class="mb-1 fw-bold text-white">C&G Electrónica</h3>
                <p class="text-white-50 small mb-0">Sistema de Inventario y Facturación</p>
            </div>

            <div class="card-body p-4 p-sm-5 text-start">

                <!-- Alerta de error adaptada al tema oscuro -->
                @if (ViewData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border border-danger border-opacity-50 small"
                         style="background-color: rgba(220, 53, 69, 0.15); color: #ea868f;" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewData["Error"]
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <!-- Campo Usuario -->
                    <div class="mb-3">
                        <label asp-for="NombreUsuario" class="form-label text-white fw-semibold small">Usuario</label>
                        <div class="input-group">
                            <span class="input-group-text border-secondary border-opacity-25 text-white-50"
                                  style="background-color: rgba(255, 255, 255, 0.08);">
                                <i class="bi bi-person-fill"></i>
                            </span>
                            <input asp-for="NombreUsuario" class="form-control text-white border-secondary border-opacity-25"
                                   placeholder="Ej. admin"
                                   style="background-color: rgba(255, 255, 255, 0.05);"
                                   autocomplete="username" autofocus />
                        </div>
                        <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                    </div>

                    <!-- Campo Contraseña -->
                    <div class="mb-3">
                        <label asp-for="Contrasena" class="form-label text-white fw-semibold small">Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text border-secondary border-opacity-25 text-white-50"
                                  style="background-color: rgba(255, 255, 255, 0.08);">
                                <i class="bi bi-lock-fill"></i>
                            </span>
                            <input asp-for="Contrasena" class="form-control text-white border-secondary border-opacity-25"
                                   placeholder="••••••••"
                                   style="background-color: rgba(255, 255, 255, 0.05);"
                                   autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Contrasena" class="text-danger small"></span>
                    </div>

                    <!-- Switch Recordarme -->
                    <div class="form-check form-switch mb-4">
                        <input asp-for="Recordarme" class="form-check-input" />
                        <label asp-for="Recordarme" class="form-check-label text-white-50 small">Recordar sesión en este equipo</label>
                    </div>

                    <!-- Botón de Ingreso Principal -->
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow fw-semibold">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Ingresar al Sistema
                        </button>
                    </div>
                </form>
            </div>

            <!-- Pie de tarjeta en tono oscuro parejo -->
            <div class="card-footer text-center py-3 border-top border-secondary border-opacity-25" style="background-color: rgba(0, 0, 0, 0.25);">
                <small class="text-white-50" style="font-size: 0.8rem;">
                    C&G Electrónica &copy; @DateTime.Now.Year - Todos los derechos reservados
                </small>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}