@model IEnumerable<Categoria>
@using CG_Electronica.Web.Helpers

@{
    ViewData["Title"] = "Categorías";
}

<div class="container-fluid px-4">
    <!-- Encabezado y Breadcrumbs -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
        <div>
            <h1 class="mb-0 text-white">Categorías</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-primary text-decoration-none">Inicio</a></li>
                <li class="breadcrumb-item active text-white-50">Categorías</li>
            </ol>
        </div>
        @if (User.TienePermiso("Catalogos.Editar"))
        {
            <a class="btn btn-primary shadow-sm" asp-action="Create">
                <i class="bi bi-plus-circle me-1"></i> Nueva Categoría
            </a>
        }
    </div>

    <!-- Alertas TempData -->
    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Ok"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tarjeta Principal con Estilo Dark -->
    <div class="card shadow-sm border border-secondary border-opacity-25 rounded-4 overflow-hidden mb-4" style="background-color: #111c30;">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3 border-bottom border-secondary border-opacity-25">
            <span class="fw-bold">
                <i class="bi bi-tags-fill text-primary me-2"></i>Listado de Categorías de Productos
            </span>
            <span class="badge bg-secondary">Total: @(Model?.Count() ?? 0)</span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Nombre de la Categoría</th>
                            <th class="text-center" style="width: 140px;">Estado</th>
                            @if (User.TienePermiso("Catalogos.Editar"))
                            {
                                <th class="text-end" style="width: 200px;">Acciones</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <!-- Nombre de la Categoría -->
                                    <td class="fw-bold text-white">
                                        <i class="bi bi-tag text-secondary me-2"></i>@item.NombreCategoria
                                    </td>

                                    <!-- Estado (En su columna central) -->
                                    <td class="text-center">
                                        @if (item.Estado == "Activo")
                                        {
                                            <span class="badge bg-success bg-opacity-75 px-2 py-1">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-2 py-1">Inactivo</span>
                                        }
                                    </td>

                                    <!-- Acciones (Al final de la fila) -->
                                    @if (User.TienePermiso("Catalogos.Editar"))
                                    {
                                        <td class="text-end">
                                            <a asp-action="Edit" asp-route-id="@item.IdCategoria" class="btn btn-warning btn-sm shadow-sm" title="Editar">
                                                <i class="bi bi-pencil-square"></i> Editar
                                            </a>
                                            @if (item.Estado == "Activo")
                                            {
                                                <a asp-action="Delete" asp-route-id="@item.IdCategoria" class="btn btn-danger btn-sm shadow-sm" title="Inactivar">
                                                    <i class="bi bi-trash"></i> Eliminar
                                                </a>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                    No hay categorías registradas en el sistema.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>