@model CG_Electronica.Web.Models.Servicio

@{
    ViewData["Title"] = "Editar Servicio";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Editar Servicio</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Servicios</a></li>
        <li class="breadcrumb-item active">Editar</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-edit me-1"></i>
            Actualizar Datos del Servicio
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                
                <!-- Clave primaria real -->
                <input type="hidden" asp-for="IdItem" />

                <div class="mb-3">
                    <label asp-for="NombreServicio" class="form-label font-weight-bold">Nombre del Servicio</label>
                    <input asp-for="NombreServicio" class="form-control" />
                    <span asp-validation-for="NombreServicio" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PrecioVenta" class="form-label font-weight-bold">Precio de Venta ($)</label>
                    <input asp-for="PrecioVenta" class="form-control" type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="PrecioVenta" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Estado" class="form-label font-weight-bold">Estado</label>
                    <select asp-for="Estado" class="form-select">
                        <option value="Activo">Activo</option>
                        <option value="Inactivo">Inactivo</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}