@model IEnumerable<CG_Electronica.Web.Models.Servicio>
@using CG_Electronica.Web.Helpers

@{
    ViewData["Title"] = "Listado de Servicios";
}

<div class="container-fluid px-4">
    <!-- Encabezado y Breadcrumbs -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
        <div>
            <h1 class="mb-0">Servicios</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item active">Servicios</li>
            </ol>
        </div>
        @if (User.TienePermiso("Servicios.Editar"))
        {
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Nuevo Servicio
            </a>
        }
    </div>

    <!-- Alertas TempData -->
    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Ok"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tarjeta Principal con Tabla -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
            <span class="fw-bold">
                <i class="bi bi-tools me-2"></i>Catálogo de Servicios Facturables
            </span>
            <span class="badge bg-secondary">Total: @(Model?.Count() ?? 0)</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 80px;">ID</th>
                            <th>Nombre del Servicio</th>
                            <th class="text-end">Precio Venta</th>
                            <th class="text-center">Estado</th>
                            @if (User.TienePermiso("Servicios.Editar"))
                            {
                                <th class="text-center" style="width: 130px;">Acciones</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-muted fw-bold">#@item.IdItem</td>
                                    <td class="fw-semibold">@item.NombreServicio</td>
                                    <td class="text-end fw-bold text-primary">C$ @item.PrecioVenta.ToString("N2")</td>
                                    <td class="text-center">
                                        @if (item.Estado == "Activo")
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    @if (User.TienePermiso("Servicios.Editar"))
                                    {
                                        <td class="text-center">
                                            <a asp-action="Edit"
                                               asp-route-id="@item.IdItem"
                                               class="btn btn-warning btn-sm shadow-sm"
                                               title="Editar Servicio">
                                                <i class="bi bi-pencil-square me-1"></i> Editar
                                            </a>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                    No hay servicios registrados en el sistema.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>