<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CG_Electronica.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-microchip me-1"></i> C&amp;G Electrónica
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Home" asp-action="Index">
                                    <i class="fas fa-home me-1"></i> Inicio
                                </a>
                            </li>

                            <!-- DROPDOWN: GESTIÓN COMERCIAL -->
                            @if (User.TienePermiso("Catalogos.Ver") || User.TienePermiso("Clientes.Ver"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" id="comercialDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-store me-1"></i> Comercial
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="comercialDropdown">
                                        @if (User.TienePermiso("Catalogos.Ver") || User.TienePermiso("Clientes.Ver"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Clientes" asp-action="Index"><i class="fas fa-users me-2"></i> Clientes</a></li>
                                        }
                                        @if (User.TienePermiso("Catalogos.Ver"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Productos" asp-action="Index"><i class="fas fa-box me-2"></i> Productos</a></li>
                                            <li><a class="dropdown-item" asp-controller="Servicios" asp-action="Index"><i class="fas fa-concierge-bell me-2"></i> Servicios</a></li>
                                        }
                                    </ul>
                                </li>
                            }

                            <!-- DROPDOWN: CATÁLOGOS -->
                            @if (User.TienePermiso("Catalogos.Ver"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" id="catalogosDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-tags me-1"></i> Catálogos
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="catalogosDropdown">
                                        <li><a class="dropdown-item" asp-controller="Categorias" asp-action="Index"><i class="fas fa-folder me-2"></i> Categorías</a></li>
                                        <li><a class="dropdown-item" asp-controller="Marcas" asp-action="Index"><i class="fas fa-trademark me-2"></i> Marcas</a></li>
                                    </ul>
                                </li>
                            }

                            <!-- DROPDOWN: OPERACIONES / INVENTARIO Y FACTURACIÓN -->
                            @if (User.TienePermiso("Inventario.Ver") || User.TienePermiso("Ventas.Ver") || User.TienePermiso("Facturas.Ver"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" id="operacionesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-cash-register me-1"></i> Operaciones
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="operacionesDropdown">
                                        @if (User.TienePermiso("Ventas.Ver") || User.TienePermiso("Facturas.Ver"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Facturas" asp-action="Index"><i class="fas fa-file-invoice-dollar me-2"></i> Facturación</a></li>
                                        }
                                        @if (User.TienePermiso("Inventario.Ver"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Inventario" asp-action="Index"><i class="fas fa-warehouse me-2"></i> Inventario &amp; Kardex</a></li>
                                        }
                                    </ul>
                                </li>
                            }

                            <!-- DROPDOWN: ADMINISTRACIÓN Y SEGURIDAD -->
                            @if (User.TienePermiso("Auditoria.Ver") || User.TienePermiso("Usuarios.Ver") || User.TienePermiso("Roles.Ver"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-shield-alt me-1"></i> Administración
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                        @if (User.TienePermiso("Auditoria.Ver"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Auditoria" asp-action="Index"><i class="fas fa-history me-2"></i> Auditoría</a></li>
                                        }
                                        @if (User.TienePermiso("Usuarios.Ver"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index"><i class="fas fa-user-cog me-2"></i> Usuarios</a></li>
                                        }
                                        @if (User.TienePermiso("Roles.Ver"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Roles" asp-action="Index"><i class="fas fa-user-shield me-2"></i> Roles y Permisos</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <!-- SECCIÓN DE USUARIO Y LOGOUT -->
                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-warning" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle me-1"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li><span class="dropdown-item-text text-muted small">Rol: @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Usuario")</span></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="form-inline px-3 py-1">
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                                <i class="fas fa-sign-out-alt me-1"></i> Cerrar Sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-sign-in-alt me-1"></i> Iniciar Sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CG_Electronica.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
