<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - C&G Electrónica</title>

    <!-- CSS Core -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Librería oficial de Bootstrap Icons (Estandarizada) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Estilo para modo oscuro de la web general -->
    <style>
        body {
            background-color: #0d1527;
            color: #f8f9fa;
        }

        .footer {
            background-color: #111c30;
            border-top: 1px solid rgba(255,255,255,0.1) !important;
        }
    </style>
</head>
<body>
    <header>
        <!-- Navbar con tema oscuro corporativo -->
        <nav class="navbar navbar-expand-lg navbar-dark border-bottom mb-4 shadow-sm" style="background-color: #111c30; border-color: rgba(255,255,255,0.1) !important;">
            <div class="container-fluid px-4">

                <!-- Branding -->
                <a class="navbar-brand fw-bold text-primary d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-phone-fill fs-4 me-2"></i> C&G Electrónica
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-3">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door me-1"></i> Inicio
                                </a>
                            </li>

                            <!-- DROPDOWN: GESTIÓN COMERCIAL -->
                            @if (User.TienePermiso("Catalogos.Ver") || User.TienePermiso("Clientes.Ver") || User.TienePermiso("Facturas.Ver"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" id="comercialDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-shop me-1"></i> Comercial
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark shadow" aria-labelledby="comercialDropdown">
                                        @if (User.TienePermiso("Catalogos.Ver") || User.TienePermiso("Clientes.Ver"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Clientes" asp-action="Index"><i class="bi bi-people me-2 text-info"></i> Clientes</a></li>
                                        }
                                        @if (User.TienePermiso("Catalogos.Ver"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Productos" asp-action="Index"><i class="bi bi-box-seam me-2 text-warning"></i> Productos</a></li>
                                            <li><a class="dropdown-item" asp-controller="Servicios" asp-action="Index"><i class="bi bi-tools me-2 text-warning"></i> Servicios</a></li>
                                        }
                                        @if (User.TienePermiso("Facturas.Ver"))
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item" asp-controller="Facturas" asp-action="Index"><i class="bi bi-receipt me-2 text-success"></i> Facturación</a></li>
                                            <li><a class="dropdown-item" asp-controller="Reportes" asp-action="Ventas"><i class="bi bi-graph-up-arrow me-2 text-primary"></i> Reportes de Ventas</a></li>
                                        }
                                    </ul>
                                </li>
                            }

                            <!-- DROPDOWN: CATÁLOGOS -->
                            @if (User.TienePermiso("Catalogos.Ver"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" id="catalogosDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-tags me-1"></i> Catálogos
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark shadow" aria-labelledby="catalogosDropdown">
                                        <li><a class="dropdown-item" asp-controller="Categorias" asp-action="Index"><i class="bi bi-folder2-open me-2 text-primary"></i> Categorías</a></li>
                                        <li><a class="dropdown-item" asp-controller="Marcas" asp-action="Index"><i class="bi bi-bookmark-star me-2 text-primary"></i> Marcas</a></li>
                                    </ul>
                                </li>
                            }

                            <!-- DROPDOWN: INVENTARIO -->
                            @if (User.TienePermiso("Inventario.Ver"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-light" asp-controller="Inventario" asp-action="Index">
                                        <i class="bi bi-boxes me-1"></i> Inventario
                                    </a>
                                </li>
                            }

                            <!-- DROPDOWN: ADMINISTRACIÓN Y SEGURIDAD -->
                            @if (User.TienePermiso("Auditoria.Ver") || User.TienePermiso("Usuarios.Ver") || User.TienePermiso("Roles.Ver"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-shield-lock me-1"></i> Administración
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark shadow" aria-labelledby="adminDropdown">
                                        @if (User.TienePermiso("Auditoria.Ver"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Auditoria" asp-action="Index"><i class="bi bi-clock-history me-2 text-info"></i> Auditoría</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                        }
                                        @if (User.TienePermiso("Usuarios.Ver"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-person-gear me-2 text-warning"></i> Usuarios</a></li>
                                        }
                                        @if (User.TienePermiso("Roles.Ver"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Roles" asp-action="Index"><i class="bi bi-shield-check me-2 text-warning"></i> Roles y Permisos</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <!-- SECCIÓN DE PERFIL DE USUARIO -->
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-warning fw-semibold px-3 py-2 rounded-pill border border-warning border-opacity-25" style="background-color: rgba(255, 193, 7, 0.1);" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark shadow mt-2" aria-labelledby="userDropdown">
                                    <li class="px-3 py-2 text-center">
                                        <span class="d-block text-white fw-bold">@User.FindFirst("NombreCompleto")?.Value</span>
                                        <span class="badge bg-primary mt-1">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Usuario")</span>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-2">
                                            <button type="submit" class="btn btn-danger btn-sm w-100 rounded-pill shadow-sm">
                                                <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary rounded-pill px-4" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-md-4">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <!-- Footer Integrado al Tema Oscuro -->
    <footer class="footer text-muted py-3 mt-auto">
        <div class="container-fluid px-4 text-center">
            <span class="text-white-50 small">&copy; @DateTime.Now.Year - C&G Electrónica - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-primary text-decoration-none">Privacidad</a></span>
        </div>
    </footer>

    <!-- Scripts Core -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>