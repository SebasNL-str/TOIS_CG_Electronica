@model IEnumerable<Marca>
@{
    ViewData["Title"] = "Marcas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    @if (User.TienePermiso("Catalogos.Editar"))
    {
        <a class="btn btn-primary" asp-action="Create">+ Nueva marca</a>
    }
</div>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Ok"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(m => m.NombreMarca)</th>
                    <th>@Html.DisplayNameFor(m => m.Estado)</th>
                    @if (User.TienePermiso("Catalogos.Editar"))
                    {
                        <th class="text-end">Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.NombreMarca</td>
                        <td>
                            <span class="badge @(item.Estado == "Activo" ? "bg-success" : "bg-secondary")">
                                @item.Estado
                            </span>
                        </td>
                        @if (User.TienePermiso("Catalogos.Editar"))
                        {
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.IdMarca">Editar</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.IdMarca">Eliminar</a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
