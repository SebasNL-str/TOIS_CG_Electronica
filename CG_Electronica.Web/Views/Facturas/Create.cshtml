@model CG_Electronica.Web.Models.ViewModels.ViewModelFacturaCreate

@{
    ViewData["Title"] = "Nueva Factura";
}

<div class="container-fluid px-4">
    <!-- Encabezado y Breadcrumbs -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
        <div>
            <h1 class="mb-0 text-white">Facturación</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-primary text-decoration-none">Inicio</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-primary text-decoration-none">Facturas</a></li>
                <li class="breadcrumb-item active text-white-50">Nueva Venta</li>
            </ol>
        </div>
    </div>

    <!-- Tarjeta Principal en Modo Oscuro -->
    <div class="card shadow-lg border border-secondary border-opacity-25 rounded-4 overflow-hidden mb-4" style="background-color: #111c30;">

        <!-- Franja superior azul de acento -->
        <div class="bg-primary" style="height: 5px;"></div>

        <div class="card-header border-bottom border-secondary border-opacity-25 py-3" style="background-color: rgba(0, 0, 0, 0.2);">
            <span class="fw-bold text-white fs-5">
                <i class="bi bi-receipt text-primary me-2"></i>Emitir Nueva Factura de Venta
            </span>
        </div>

        <div class="card-body p-4 text-start">
            <!-- Formulario con METHOD POST EXPLÍCITO -->
            <form asp-action="Create" method="post" id="formFactura">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                <!-- Cabecera de la Factura: N° Factura y Cliente -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="NumeroFactura" class="form-label text-white fw-semibold small">N° de Factura</label>
                        <div class="input-group">
                            <span class="input-group-text border-secondary border-opacity-50 text-white-50" style="background-color: rgba(255, 255, 255, 0.08);">
                                <i class="bi bi-hash"></i>
                            </span>
                            <input asp-for="NumeroFactura" class="form-control text-white border-secondary border-opacity-50 fw-bold"
                                   style="background-color: rgba(255, 255, 255, 0.05);" readonly />
                        </div>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="IdCliente" class="form-label text-white fw-semibold small">Cliente a Facturar</label>
                        <select asp-for="IdCliente" class="form-select text-white border-secondary border-opacity-50"
                                style="background-color: #0d1527;" asp-items="ViewBag.Clientes" required>
                            <option value="">-- Seleccione un Cliente --</option>
                        </select>
                        <span asp-validation-for="IdCliente" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="border-secondary opacity-50 my-4" />

                <!-- Selector de Artículos y Cantidad -->
                <h5 class="text-primary fw-bold mb-3">
                    <i class="bi bi-cart-plus me-2"></i>Agregar Productos o Servicios
                </h5>

                <div class="row g-3 align-items-end mb-4 p-3 rounded-3 border border-secondary border-opacity-25" style="background-color: rgba(255, 255, 255, 0.02);">
                    <div class="col-md-6">
                        <label class="form-label text-white-50 small">Seleccionar Artículo</label>
                        <select id="selectProducto" class="form-select text-white border-secondary border-opacity-50" style="background-color: #0d1527;">
                            <option value="">-- Seleccione producto o servicio --</option>
                            @if (ViewBag.Items != null)
                            {
                                foreach (var item in ViewBag.Items)
                                {
                                    <option value="@item.IdItem" data-precio="@item.PrecioVenta">
                                        @item.Nombre — C$ @item.PrecioVenta.ToString("N2")
                                    </option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-white-50 small">Cantidad</label>
                        <input type="number" id="inputCantidad" class="form-control text-white border-secondary border-opacity-50"
                               style="background-color: #0d1527;" value="1" min="1" />
                    </div>
                    <div class="col-md-3">
                        <button type="button" id="btnAgregarItem" class="btn btn-success w-100 shadow-sm fw-semibold">
                            <i class="bi bi-plus-circle me-1"></i> Agregar a Detalle
                        </button>
                    </div>
                </div>

                <!-- Tabla Dinámica de Detalles -->
                <div class="table-responsive mb-4">
                    <table class="table table-striped table-hover align-middle mb-0" id="tablaDetalles">
                        <thead class="table-dark">
                            <tr>
                                <th>Artículo Facturado</th>
                                <th class="text-center" style="width: 140px;">Cantidad</th>
                                <th class="text-end" style="width: 180px;">Subtotal Línea</th>
                                <th class="text-center" style="width: 100px;">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Mensaje inicial cuando la tabla está vacía -->
                            <tr id="filaVacia">
                                <td colspan="4" class="text-center text-muted py-4">
                                    <i class="bi bi-cart-x display-6 d-block mb-2"></i>
                                    No ha agregado ningún producto o servicio a la venta.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Resumen Contable / Totales en Córdobas  -->
                <div class="d-flex justify-content-end mb-4">
                    <div class="p-3 rounded-3 border border-secondary border-opacity-25" style="background-color: rgba(255, 255, 255, 0.05); width: 320px;">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal:</span>
                            <strong id="lblSubtotal" class="text-white">C$ 0.00</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">IVA (15%):</span>
                            <strong id="lblIva" class="text-white">C$ 0.00</strong>
                        </div>
                        <hr class="border-secondary opacity-50 my-2" />
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fs-5 fw-bold text-white">Total a Pagar:</span>
                            <strong class="fs-4 text-primary" id="lblTotal">C$ 0.00</strong>
                        </div>
                    </div>
                </div>

                <!-- Botones de Acción -->
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill px-4 shadow fw-semibold">
                        <i class="bi bi-receipt me-1"></i> Emitir y Cobrar Factura
                    </button>
                    <a asp-action="Index" class="btn btn-outline-light btn-lg rounded-pill px-4">
                        <i class="bi bi-x-circle me-1"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        let itemsFactura = [];

        document.getElementById('btnAgregarItem').addEventListener('click', function () {
            const selectProducto = document.getElementById('selectProducto');
            const inputCantidad = document.getElementById('inputCantidad');

            const idItem = selectProducto.value;
            const opcion = selectProducto.options[selectProducto.selectedIndex];
            const descripcionItem = opcion ? opcion.text : '';
            const precio = parseFloat(opcion ? (opcion.dataset.precio || '0') : '0');
            const cantidad = parseInt(inputCantidad.value);

            if (!idItem) {
                alert('Por favor seleccione un producto o servicio de la lista.');
                return;
            }

            if (isNaN(cantidad) || cantidad <= 0) {
                alert('Ingrese una cantidad válida mayor a 0.');
                return;
            }

            // Sumar si ya existe o agregarlo nuevo
            const indexExistente = itemsFactura.findIndex(i => i.idItem === idItem);
            if (indexExistente >= 0) {
                itemsFactura[indexExistente].cantidad += cantidad;
            } else {
                itemsFactura.push({
                    idItem: idItem,
                    descripcion: descripcionItem,
                    precio: precio,
                    cantidad: cantidad
                });
            }

            actualizarTablaDetalles();
            inputCantidad.value = 1;
        });

        function actualizarTablaDetalles() {
            const tbody = document.querySelector('#tablaDetalles tbody');
            tbody.innerHTML = '';

            if (itemsFactura.length === 0) {
                tbody.innerHTML = `
                    <tr id="filaVacia">
                        <td colspan="4" class="text-center text-muted py-4">
                            <i class="bi bi-cart-x display-6 d-block mb-2"></i>
                            No ha agregado ningún producto o servicio a la venta.
                        </td>
                    </tr>
                `;
                document.getElementById('lblSubtotal').textContent = 'C$ 0.00';
                document.getElementById('lblIva').textContent = 'C$ 0.00';
                document.getElementById('lblTotal').textContent = 'C$ 0.00';
                return;
            }

            itemsFactura.forEach((item, index) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>
                        <strong class="text-white">${item.descripcion}</strong>
                        <input type="hidden" name="items[${index}].IdItem" value="${item.idItem}" />
                    </td>
                    <td class="text-center fw-bold">
                        ${item.cantidad}
                        <input type="hidden" name="items[${index}].Cantidad" value="${item.cantidad}" />
                    </td>
                    <td class="text-end fw-semibold text-primary">C$ ${(item.precio * item.cantidad).toFixed(2)}</td>
                    <td class="text-center">
                        <button type="button" class="btn btn-outline-danger btn-sm rounded-circle" onclick="eliminarItem(${index})" title="Quitar">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            // Cálculos en Córdobas con IVA 15%
            const subtotal = itemsFactura.reduce((sum, item) => sum + (item.precio * item.cantidad), 0);
            const iva = subtotal * 0.15;
            const total = subtotal + iva;

            document.getElementById('lblSubtotal').textContent = `C$ ${subtotal.toFixed(2)}`;
            document.getElementById('lblIva').textContent = `C$ ${iva.toFixed(2)}`;
            document.getElementById('lblTotal').textContent = `C$ ${total.toFixed(2)}`;
        }

        function eliminarItem(index) {
            itemsFactura.splice(index, 1);
            actualizarTablaDetalles();
        }

        // Validación defensiva antes de enviar el formulario
        document.getElementById('formFactura').addEventListener('submit', function (e) {
            if (itemsFactura.length === 0) {
                e.preventDefault();
                alert('Debe agregar al menos un producto o servicio para poder emitir la factura.');
            }
        });
    </script>
}