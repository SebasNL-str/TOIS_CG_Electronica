@model IEnumerable<Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    @if (User.TienePermiso("Clientes.Editar"))
    {
        <a class="btn btn-primary" asp-action="Create">+ Nuevo cliente</a>
    }
</div>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Ok"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(m => m.NombreCliente)</th>
            <th>@Html.DisplayNameFor(m => m.Cedula)</th>
            <th>@Html.DisplayNameFor(m => m.Telefono)</th>
            @if (User.TienePermiso("Clientes.Editar"))
            {
                <th class="text-end">Acciones</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NombreCliente</td>
                <td>@item.Cedula</td>
                <td>@item.Telefono</td>
                @if (User.TienePermiso("Clientes.Editar"))
                {
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.IdCliente">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.IdCliente">Eliminar</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
