@model IEnumerable<Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    @if (User.TienePermiso("Clientes.Editar"))
    {
        <a class="btn btn-primary" asp-action="Create">+ Nuevo cliente</a>
    }
</div>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Ok"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th>Nombre del Cliente</th>
            <th>Cédula</th>
            <th>Teléfono</th>
            <th>Estado</th> <!-- 1. Cabecera Estado -->
            @if (User.TienePermiso("Clientes.Editar"))
            {
                <th class="text-end">Acciones</th> <!-- 2. Cabecera Acciones -->
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NombreCliente</td>
                <td>@item.Cedula</td>
                <td>@item.Telefono</td>
                <td>
                    <!-- 1. Celda Estado (Aquí va el badge) -->
                    @if (item.Estado == "Activo")
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </td>
                @if (User.TienePermiso("Clientes.Editar"))
                {
                    <td class="text-end">
                        <!-- 2. Celda Acciones -->
                        <a asp-action="Edit" asp-route-id="@item.IdCliente" class="btn btn-sm btn-warning">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                        @if (item.Estado == "Activo")
                        {
                            <a asp-action="Delete" asp-route-id="@item.IdCliente" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i> Eliminar
                            </a>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
    </div>
</div>


