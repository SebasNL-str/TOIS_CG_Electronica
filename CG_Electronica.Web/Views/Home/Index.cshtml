@model CG_Electronica.Web.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Panel de Control";
    var nombreUsuario = User.Identity?.Name ?? "Usuario";
}

<div class="container-fluid px-4">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Panel de Control</h1>
            <p class="text-muted mb-0">Bienvenido de nuevo, <strong>@nombreUsuario</strong>. Aquí tienes una visión general de las operaciones.</p>
        </div>
        <div>
            <span class="badge bg-primary fs-6 p-2 shadow-sm">
                <i class="fas fa-calendar-alt me-1"></i> @DateTime.Now.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))
            </span>
        </div>
    </div>

    <!-- Fila de Tarjetas Informativas (Stat Cards) -->
    <div class="row">
        <!-- Ventas del Período -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card shadow h-100 py-2 border-0 border-start border-4 border-primary">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-primary text-uppercase mb-1">Ventas Totales</div>
                            <div class="h5 mb-0 fw-bold text-dark">@Model.TotalVentasPeriodo.ToString("C2")</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-dollar-sign fa-2x text-primary opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Facturas Emitidas -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card shadow h-100 py-2 border-0 border-start border-4 border-success">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-success text-uppercase mb-1">Facturas Emitidas</div>
                            <div class="h5 mb-0 fw-bold text-dark">@Model.CantidadFacturasEmitidas <span class="small text-muted font-weight-normal">(Anuladas: @Model.CantidadFacturasAnuladas)</span></div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-file-invoice-dollar fa-2x text-success opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Clientes Registrados -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card shadow h-100 py-2 border-0 border-start border-4 border-info">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-info text-uppercase mb-1">Clientes Totales</div>
                            <div class="h5 mb-0 fw-bold text-dark">@Model.TotalClientes</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-info opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Alerta de Stock Bajo -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card shadow h-100 py-2 border-0 border-start border-4 @(Model.ProductosStockBajo > 0 ? "border-danger" : "border-warning")">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold @(Model.ProductosStockBajo > 0 ? "text-danger" : "text-warning") text-uppercase mb-1">Stock Crítico</div>
                            <div class="h5 mb-0 fw-bold text-dark">@Model.ProductosStockBajo <span class="small text-muted font-weight-normal">/ @Model.TotalProductos prod.</span></div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-exclamation-triangle fa-2x @(Model.ProductosStockBajo > 0 ? "text-danger" : "text-warning") opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Accesos Rápidos con Restricción de Permisos -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white fw-bold">
                    <i class="fas fa-bolt me-1"></i> Accesos Rápidos
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Facturas" asp-action="Create" class="btn btn-outline-primary">
                            <i class="fas fa-file-invoice me-1"></i> Nueva Factura
                        </a>
                        @if (Model.TienePermisoCatalogos)
                        {
                            <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-box me-1"></i> Productos
                            </a>
                            <a asp-controller="Servicios" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-concierge-bell me-1"></i> Servicios
                            </a>
                            <a asp-controller="Categorias" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-tags me-1"></i> Categorías y Marcas
                            </a>
                        }
                        @if (Model.TienePermisoInventario)
                        {
                            <a asp-controller="Inventario" asp-action="Index" class="btn btn-outline-success">
                                <i class="fas fa-warehouse me-1"></i> Inventario
                            </a>
                        }
                        @if (Model.TienePermisoClientes)
                        {
                            <a asp-controller="Clientes" asp-action="Index" class="btn btn-outline-info">
                                <i class="fas fa-address-book me-1"></i> Clientes
                            </a>
                        }
                        @if (Model.TienePermisoAuditoria)
                        {
                            <a asp-controller="Auditoria" asp-action="Index" class="btn btn-outline-dark">
                                <i class="fas fa-history me-1"></i> Auditoría
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Actividad Reciente (Condicionada al Permiso de Auditoría) -->
    @if (Model.TienePermisoAuditoria)
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                <span><i class="fas fa-stream me-1"></i> Actividad Reciente del Sistema</span>
                <a asp-controller="Auditoria" asp-action="Index" class="btn btn-sm btn-light text-dark">Ver Todo</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha / Hora</th>
                                <th>Acción</th>
                                <th>Registro Afectado</th>
                                <th>Usuario</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.UltimasAuditorias != null && Model.UltimasAuditorias.Any())
                            {
                                foreach (var item in Model.UltimasAuditorias)
                                {
                                    <tr>
                                        <td>@item.FechaHora.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td><span class="badge bg-info text-dark">@item.Accion</span></td>
                                        <td><code>@item.RegistroAfectado</code></td>
                                        <td>@(item.Usuario?.NombreUsuario ?? "Sistema")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">No hay registros de actividad reciente.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>