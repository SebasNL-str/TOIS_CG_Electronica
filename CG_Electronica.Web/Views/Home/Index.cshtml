@model CG_Electronica.Web.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Panel de Control";
    var nombreUsuario = User.Identity?.Name ?? "Usuario";
}

<div class="container-fluid px-4">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
        <div>
            <h1 class="h3 mb-0">Panel de Control</h1>
            <p class="mb-0">
                Bienvenido de nuevo, <strong>@nombreUsuario</strong>.
                Aquí tienes una visión general de las operaciones.
            </p>
        </div>

        <div>
            <span class="badge bg-primary fs-6 p-2 shadow-sm">
                <i class="fas fa-calendar-alt me-1"></i>
                @DateTime.Now.ToString(
                    "dd 'de' MMMM 'de' yyyy",
                    new System.Globalization.CultureInfo("es-ES")
                )
            </span>
        </div>
    </div>

    <!-- Fila de Tarjetas Informativas -->
    <div class="row">

        <!-- Ventas del Período -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card shadow h-100 py-2 border-0 border-start border-4 border-primary">
                <div class="card-body">
                    <div class="row g-0 align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-uppercase mb-1"
                                 style="color: var(--db-accent);">
                                Ventas Totales
                            </div>

                            <div class="h5 mb-0 fw-bold"
                                 style="color: var(--db-text-main);">
                                @Model.TotalVentasPeriodo.ToString("C2")
                            </div>
                        </div>

                        <div class="col-auto">
                            <i class="fas fa-dollar-sign fa-2x opacity-50"
                               style="color: var(--db-accent);"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Facturas Emitidas -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card shadow h-100 py-2 border-0 border-start border-4"
                 style="border-left-color: var(--success-text) !important;">
                <div class="card-body">
                    <div class="row g-0 align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-uppercase mb-1"
                                 style="color: var(--success-text);">
                                Facturas Emitidas
                            </div>

                            <div class="h5 mb-0 fw-bold"
                                 style="color: var(--db-text-main);">
                                @Model.CantidadFacturasEmitidas

                                <span class="small fw-normal"
                                      style="color: var(--db-text-muted);">
                                    (Anuladas: @Model.CantidadFacturasAnuladas)
                                </span>
                            </div>
                        </div>

                        <div class="col-auto">
                            <i class="fas fa-file-invoice-dollar fa-2x opacity-50"
                               style="color: var(--success-text);"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Clientes Registrados -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card shadow h-100 py-2 border-0 border-start border-4"
                 style="border-left-color: var(--db-accent) !important;">
                <div class="card-body">
                    <div class="row g-0 align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-uppercase mb-1"
                                 style="color: var(--db-accent);">
                                Clientes Totales
                            </div>

                            <div class="h5 mb-0 fw-bold"
                                 style="color: var(--db-text-main);">
                                @Model.TotalClientes
                            </div>
                        </div>

                        <div class="col-auto">
                            <i class="fas fa-users fa-2x opacity-50"
                               style="color: var(--db-accent);"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Alerta de Stock Bajo -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card shadow h-100 py-2 border-0 border-start border-4"
                 style="border-left-color: @(Model.ProductosStockBajo > 0 ? "var(--danger-text)" : "var(--warning-text)") !important;">
                <div class="card-body">
                    <div class="row g-0 align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-uppercase mb-1"
                                 style="color: @(Model.ProductosStockBajo > 0 ? "var(--danger-text)" : "var(--warning-text)");">
                                Stock Crítico
                            </div>

                            <div class="h5 mb-0 fw-bold"
                                 style="color: var(--db-text-main);">
                                @Model.ProductosStockBajo

                                <span class="small fw-normal"
                                      style="color: var(--db-text-muted);">
                                    / @Model.TotalProductos prod.
                                </span>
                            </div>
                        </div>

                        <div class="col-auto">
                            <i class="fas fa-exclamation-triangle fa-2x opacity-50"
                               style="color: @(Model.ProductosStockBajo > 0 ? "var(--danger-text)" : "var(--warning-text)");"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Accesos Rápidos con Restricción de Permisos -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">

                <div class="card-header fw-bold">
                    <i class="fas fa-bolt me-1"></i>
                    Accesos Rápidos
                </div>

                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">

                        <a asp-controller="Facturas"
                           asp-action="Create"
                           class="btn btn-primary">
                            <i class="fas fa-file-invoice me-1"></i>
                            Nueva Factura
                        </a>

                        @if (Model.TienePermisoCatalogos)
                        {
                            <a asp-controller="Productos"
                               asp-action="Index"
                               class="btn btn-secondary">
                                <i class="fas fa-box me-1"></i>
                                Productos
                            </a>

                            <a asp-controller="Servicios"
                               asp-action="Index"
                               class="btn btn-secondary">
                                <i class="fas fa-concierge-bell me-1"></i>
                                Servicios
                            </a>

                            <a asp-controller="Categorias"
                               asp-action="Index"
                               class="btn btn-secondary">
                                <i class="fas fa-tags me-1"></i>
                                Categorías y Marcas
                            </a>
                        }

                        @if (Model.TienePermisoInventario)
                        {
                            <a asp-controller="Inventario"
                               asp-action="Index"
                               class="btn btn-success">
                                <i class="fas fa-warehouse me-1"></i>
                                Inventario
                            </a>
                        }

                        @if (Model.TienePermisoClientes)
                        {
                            <a asp-controller="Clientes"
                               asp-action="Index"
                               class="btn btn-info">
                                <i class="fas fa-address-book me-1"></i>
                                Clientes
                            </a>
                        }

                        @if (Model.TienePermisoAuditoria)
                        {
                            <a asp-controller="Auditoria"
                               asp-action="Index"
                               class="btn btn-secondary">
                                <i class="fas fa-history me-1"></i>
                                Auditoría
                            </a>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Actividad Reciente (Condicionada al Permiso de Auditoría) -->
    @if (Model.TienePermisoAuditoria)
    {
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <i class="fas fa-stream me-1"></i>
                    Actividad Reciente del Sistema
                </span>

                <a asp-controller="Auditoria"
                   asp-action="Index"
                   class="btn btn-sm btn-secondary">
                    Ver Todo
                </a>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">

                    <table class="table table-striped table-hover mb-0 align-middle">

                        <thead>
                            <tr>
                                <th>Fecha / Hora</th>
                                <th>Acción</th>
                                <th>Registro Afectado</th>
                                <th>Usuario</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.UltimasAuditorias != null && Model.UltimasAuditorias.Any())
                            {
                                foreach (var item in Model.UltimasAuditorias)
                                {
                                    <tr>
                                        <td>
                                            @item.FechaHora.ToString("yyyy-MM-dd HH:mm:ss")
                                        </td>

                                        <td>
                                            <span class="badge bg-info">
                                                @item.Accion
                                            </span>
                                        </td>

                                        <td>
                                            <code>@item.RegistroAfectado</code>
                                        </td>

                                        <td>
                                            @(item.Usuario?.NombreUsuario ?? "Sistema")
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4"
                                        class="text-center py-3"
                                        style="color: var(--db-text-muted);">
                                        No hay registros de actividad reciente.
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            </div>
        </div>
    }

</div>
