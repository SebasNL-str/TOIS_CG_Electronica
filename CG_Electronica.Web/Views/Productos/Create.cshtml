@model CG_Electronica.Web.Models.Producto

@{
    ViewData["Title"] = "Crear Producto";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Nuevo Producto</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index">Productos</a></li>
        <li class="breadcrumb-item active">Crear</li>
    </ol>

    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Descripcion" class="form-label fw-bold">Descripción del Producto</label>
                        <input asp-for="Descripcion" class="form-control" placeholder="Ej. Cargador Tipo C Rápido" />
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="Modelo" class="form-label fw-bold">Modelo</label>
                        <input asp-for="Modelo" class="form-control" />
                        <span asp-validation-for="Modelo" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="CodigoFabricante" class="form-label fw-bold">Código de Fabricante</label>
                        <input asp-for="CodigoFabricante" class="form-control" />
                        <span asp-validation-for="CodigoFabricante" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="IdMarca" class="form-label fw-bold">Marca</label>
                        <select asp-for="IdMarca" class="form-select" asp-items="ViewBag.Marcas">
                            <option value="">-- Seleccione una Marca --</option>
                        </select>
                        <span asp-validation-for="IdMarca" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="IdCategoria" class="form-label fw-bold">Categoría</label>
                        <select asp-for="IdCategoria" class="form-select" asp-items="ViewBag.Categorias">
                            <option value="">-- Seleccione una Categoría --</option>
                        </select>
                        <span asp-validation-for="IdCategoria" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Estado" class="form-label fw-bold">Estado</label>
                        <select asp-for="Estado" class="form-select">
                            <option value="Activo">Activo</option>
                            <option value="Inactivo">Inactivo</option>
                            <option value="Suspendido">Suspendido</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger"></span>
                    </div>
                </div>

                <hr />
                <h5 class="text-primary">Parámetros Económicos e Inventario Inicial</h5>

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label asp-for="PrecioVenta" class="form-label fw-bold">Precio de Venta ($)</label>
                        <input asp-for="PrecioVenta" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="PrecioVenta" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label fw-bold">Precio de Compra Inicial ($)</label>
                        <input name="precioCompraInicial" type="number" step="0.01" class="form-control" value="0.00" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label fw-bold">Stock / Existencia Inicial</label>
                        <input name="stockInicial" type="number" class="form-control" value="0" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="ExistenciasMinimas" class="form-label fw-bold">Existencias Mínimas (Alerta)</label>
                        <input asp-for="ExistenciasMinimas" type="number" class="form-control" value="5" />
                        <span asp-validation-for="ExistenciasMinimas" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Guardar Producto</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}