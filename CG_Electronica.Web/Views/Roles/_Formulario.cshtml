@model CG_Electronica.Web.Models.ViewModels.RolViewModel

<input asp-for="IdRol" type="hidden" />

<div class="mb-3">
    <label asp-for="NombreRol" class="form-label fw-bold"></label>
    <input asp-for="NombreRol" class="form-control" autocomplete="off" />
    <span asp-validation-for="NombreRol" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Descripcion" class="form-label fw-bold"></label>
    <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
    <span asp-validation-for="Descripcion" class="text-danger"></span>
</div>

<h5 class="mt-4 text-primary"><i class="bi bi-shield-check"></i> Asignación de Permisos</h5>
<hr class="mt-1 mb-3" />

<div class="row">
    @for (int i = 0; i < Model.Permisos.Count; i++)
    {
        <div class="col-md-6 mb-3">
            <div class="form-check form-switch">
                <!-- Inputs ocultos para mantener los datos de la lista durante el POST -->
                <input type="hidden" asp-for="Permisos[i].IdPermiso" />
                <input type="hidden" asp-for="Permisos[i].NombrePermiso" />
                <input type="hidden" asp-for="Permisos[i].Descripcion" />

                <!-- El Checkbox que evalúa el usuario -->
                <input class="form-check-input" type="checkbox" asp-for="Permisos[i].Seleccionado" />
                <label class="form-check-label fw-bold" asp-for="Permisos[i].Seleccionado">
                    @Model.Permisos[i].NombrePermiso
                </label>
                @if (!string.IsNullOrEmpty(Model.Permisos[i].Descripcion))
                {
                    <small class="d-block text-muted">@Model.Permisos[i].Descripcion</small>
                }
            </div>
        </div>
    }
</div>