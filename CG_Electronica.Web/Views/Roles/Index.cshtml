@model IEnumerable<CG_Electronica.Web.Models.Rol>
@using CG_Electronica.Web.Helpers

@{
    ViewData["Title"] = "Gestión de Roles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Roles y Permisos</h2>
    @if (User.TienePermiso("Roles.Editar"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-shield-plus"></i> Nuevo Rol
        </a>
    }
</div>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Nombre del Rol</th>
                    <th>Descripción</th>
                    <th class="text-center">Permisos Asignados</th>
                    @if (User.TienePermiso("Roles.Editar"))
                    {
                        <th class="text-end">Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.NombreRol</td>
                        <td>@item.Descripcion</td>
                        <td class="text-center">
                            <span class="badge bg-info text-dark">
                                @(item.RolPermisos?.Count ?? 0) permisos
                            </span>
                        </td>
                        @if (User.TienePermiso("Roles.Editar"))
                        {
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.IdRol" class="btn btn-sm btn-warning">Editar</a>
                                <!-- Proteger visualmente el rol Administrador -->
                                @if (item.NombreRol.ToLower() != "administrador")
                                {
                                    <a asp-action="Delete" asp-route-id="@item.IdRol" class="btn btn-sm btn-danger">Eliminar</a>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>