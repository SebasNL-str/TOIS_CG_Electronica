@model CG_Electronica.Web.Models.ViewModels.UsuarioViewModel

<input asp-for="IdUsuario" type="hidden" />

<div class="mb-3">
    <label asp-for="Nombre" class="form-label fw-bold"></label>
    <input asp-for="Nombre" class="form-control" placeholder="Ej. Juan Pérez" autocomplete="off" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="NombreUsuario" class="form-label fw-bold"></label>
    <input asp-for="NombreUsuario" class="form-control" placeholder="Ej. jperez" autocomplete="off" />
    <span asp-validation-for="NombreUsuario" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Clave" class="form-label fw-bold"></label>
    <input asp-for="Clave" class="form-control" placeholder="Ej. Contraseña segura (mín. 6 caracteres)" autocomplete="new-password" />
    <span asp-validation-for="Clave" class="text-danger"></span>
    @if (Model.IdUsuario > 0)
    {
        <div class="form-text text-muted">
            <i class="bi bi-info-circle"></i> Deje en blanco si no desea cambiar la contraseña actual.
        </div>
    }
</div>

<div class="mb-3">
    <label asp-for="IdRol" class="form-label fw-bold"></label>
    <select asp-for="IdRol" class="form-select" asp-items="ViewBag.Roles">
        <option value="">-- Seleccione un Rol --</option>
    </select>
    <span asp-validation-for="IdRol" class="text-danger"></span>
</div>

<!-- NUEVO: Campo Estado -->
<div class="mb-3">
    <label asp-for="Estado" class="form-label fw-bold"></label>
    <select asp-for="Estado" class="form-select">
        <option value="Activo">Activo</option>
        <option value="Inactivo">Inactivo</option>
    </select>
    <span asp-validation-for="Estado" class="text-danger"></span>
</div>